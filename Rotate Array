class Solution:
    def rotate(self, nums: list[int], k: int) -> None:
        n = len(nums)

        if n <= 1:
            return

        k %= n

        if k == 0:
            return

        def reverse(left, right):
            while left < right:
                nums[left], nums[right] = nums[right], nums[left]
                left += 1
                right -= 1

        reverse(0, n - 1)
        reverse(0, k - 1)
        reverse(k, n - 1)
